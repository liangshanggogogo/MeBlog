---
import type { MarkdownHeading } from 'astro';
import Icon from './Icon.astro';
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---
{items.length > 0 && <>
  <details class="mobile-toc">
    <summary><span><Icon name="list" size={20} />文章目录</span><span class="toc-count">{items.length} 节 <span aria-hidden="true">⌄</span></span></summary>
    <nav aria-label="文章目录"><ol>{items.map((heading) => <li class:list={{ 'toc-nested': heading.depth > 2 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
  </details>
  <aside class="desktop-toc">
    <div class="toc-inner">
      <p class="toc-title"><Icon name="list" size={18} />本文目录</p>
      <nav aria-label="文章目录"><ol>{items.map((heading) => <li class:list={{ 'toc-nested': heading.depth > 2 }}><a data-toc-link href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
      <a class="toc-top" href="#main">回到开头 ↑</a>
    </div>
  </aside>
</>}
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const headings = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((node): node is HTMLElement => !!node);
  if (headings.length) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible.length) {
        const active = visible[0].target.id;
        links.forEach((link) => {
          if (decodeURIComponent(link.hash.slice(1)) === active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    }, { rootMargin: '-100px 0px -50% 0px', threshold: 0 });
    headings.forEach((heading) => observer.observe(heading));
    window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
  }
  document.querySelectorAll<HTMLAnchorElement>('.mobile-toc a').forEach((link) => {
    link.addEventListener('click', () => { const details = link.closest('details'); if (details) details.open = false; });
  });
</script>
