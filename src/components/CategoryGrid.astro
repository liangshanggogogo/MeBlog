---
import Icon from './Icon.astro';
import { categories, trendSection, url, type Article, type Update } from '../lib/blog';
interface Props { articles: Article[]; updates: Update[]; }
const { articles, updates } = Astro.props;
---
<div class="category-grid">
  {categories.map((category) => {
    const count = articles.filter((article) => article.data.category === category.id).length;
    return <a class="category-item" href={url(`categories/${category.id}/`)}>
      <div class="category-icon"><Icon name={category.icon} size={32} /><Icon name="arrow-up-right" size={17} /></div>
      <h3>{category.name}</h3>
      <p>{category.description}</p>
      <span class="category-count">{count ? `${count} 篇文章` : '等待第一篇'}</span>
    </a>;
  })}
  <a class="category-item category-item-trends" href={url('trends/')}>
    <div class="category-icon"><Icon name={trendSection.icon} size={32} /><Icon name="arrow-up-right" size={17} /></div>
    <h3>{trendSection.name}</h3>
    <p>{trendSection.description}</p>
    <span class="category-count">每日趋势 / 每周进展{updates.length ? ` · ${updates.length} 则` : ''}</span>
  </a>
</div>
