---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CategoryGrid from './CategoryGrid.astro';
import Icon from './Icon.astro';
import { categories, getArticles, categoryFor, categoryUrl, articleUrl, shortDate, readingMinutes, url, type CategoryId } from '../lib/blog';
interface Props { selected?: CategoryId; }
const { selected } = Astro.props;
const articles = await getArticles();
const filtered = selected ? articles.filter(article => article.data.category === selected) : articles;
const title = selected ? `${categoryFor(selected).name} · 文章` : '全部文章';
---
<Base title={title} active="articles">
  <div class="shell archive-page article-browser" data-article-archive>
    <header class="page-heading">
      <h1>全部文章</h1>
      <p>按时间阅读，也可以从感兴趣的模块开始。</p>
    </header>
    <section class="archive-module-section" id="modules" aria-labelledby="modules-title">
      <div class="section-heading"><h2 id="modules-title">模块 / 系列</h2></div>
      <CategoryGrid articles={articles} archive selected={selected} />
    </section>
    <section class="archive-results" id="article-results" aria-label="文章列表">
      <nav class="category-tabs" aria-label="按模块筛选文章">
        <a class:list={{ selected: !selected }} href={url('articles/')} data-category-filter="all" data-category-name="全部" aria-current={!selected ? 'page' : undefined}>全部 <span>{articles.length}</span></a>
        {categories.map(category => <a class:list={{ selected: selected === category.id }} href={categoryUrl(category.id)} data-category-filter={category.id} data-category-name={category.name} aria-current={selected === category.id ? 'page' : undefined}>{category.name}<span>{articles.filter(a => a.data.category === category.id).length}</span></a>)}
      </nav>
      <div class="archive-search-row">
        <form class="archive-search" role="search" hidden>
          <label for="article-search" class="sr-only">搜索文章标题</label>
          <Icon name="search" size={19} />
          <input id="article-search" type="search" name="q" placeholder="搜索文章标题…" autocomplete="off" maxlength="200" />
          <kbd aria-hidden="true">/</kbd>
        </form>
        <p class="archive-result-count" role="status" aria-live="polite" aria-atomic="true">{selected ? `${categoryFor(selected).name} · ` : ''}{filtered.length} 篇文章</p>
      </div>
      <ul class="article-index-list" role="list">
        {articles.map(article => <li class="article-index-item" data-article-item data-category={article.data.category} data-title={article.data.title} hidden={!!selected && article.data.category !== selected}>
          <a class="article-index-art" href={articleUrl(article)} tabindex="-1" aria-hidden="true">
            {article.data.cover && <Image src={article.data.cover} alt="" width={240} height={160} widths={[120,240,360]} sizes="(max-width:767px) 88px, 120px" fit="contain" format="webp" loading="lazy" decoding="async" />}
          </a>
          <div class="article-index-copy">
            <h2><a href={articleUrl(article)}>{article.data.title}</a></h2>
            <div class="article-index-meta">
              <a href={categoryUrl(article.data.category)} data-category-filter={article.data.category} data-category-name={categoryFor(article.data.category).name}>{categoryFor(article.data.category).name}</a>
              <span>约 {readingMinutes(article.body)} 分钟</span>
              <time datetime={article.data.date.toISOString()}>{shortDate(article.data.date)}</time>
            </div>
          </div>
          <Icon name="arrow-up-right" size={20} class="article-index-arrow" />
        </li>)}
      </ul>
      <div class="empty-state archive-empty" hidden={filtered.length > 0}>
        <h2>{selected ? '这个模块还没有文章。' : '第一篇文章正在路上。'}</h2>
        <p>下一次探索，会在这里留下记录。</p>
        <a class="text-link" href={url('articles/')} data-clear-filter>查看全部文章 <Icon name="arrow-right" size={18} /></a>
      </div>
    </section>
  </div>
</Base>
<script>
  import '../scripts/article-archive';
</script>
