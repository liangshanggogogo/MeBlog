---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/blog';
---
<Base title="页面未找到">
  <div class="shell not-found"><p class="not-found-number">404</p><h1>这一页，暂时翻不到。</h1><p>链接可能已经改变，回到首页继续看看吧。</p><a class="text-link" href={url()}><Icon name="arrow-left" size={18} />回到首页</a></div>
</Base>
