---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import { getArticles, getUpdates, url, categoryFor, articleUrl, shortDate, readingMinutes, cadenceLabels, updateUrl } from '../lib/blog';
const [articles, updates] = await Promise.all([getArticles(), getUpdates()]);
const latest = articles[0];
---
<Base>
  <div class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hello">你好，我是 Liang Shang。</p>
        <h1 id="hero-title">在实践中探索，<br /><span>在记录中思考。</span></h1>
        <p class="hero-description">拆解技术，动手实践，也更新自己的认知。<br />把学到的东西讲清楚，记录 AI 时代的变化。</p>
        <a class="text-link hero-link" href={url('articles/')}>读一篇文章 <Icon name="arrow-right" size={21} /></a>
      </div>
      <figure class="hero-art">
        <img src={url('images/growing-thoughts.webp')} srcset={`${url('images/growing-thoughts-480.webp')} 480w, ${url('images/growing-thoughts-800.webp')} 800w, ${url('images/growing-thoughts.webp')} 1200w`} sizes="(max-width: 767px) 330px, (max-width: 1023px) 42vw, 480px" width="1200" height="800" alt="打开的书页生长成枝叶，一支铅笔放在旁边" fetchpriority="high" />
      </figure>
    </section>

    <section class="latest-section" aria-labelledby="latest-title">
      <div class="section-heading"><h2 id="latest-title">最新文章</h2><a class="quiet-link" href={url('articles/')}>全部文章 <Icon name="arrow-right" size={17} /></a></div>
      {latest ? <article class="featured-article">
        <div class="featured-main">
          <div class="article-meta"><a href={url(`categories/${latest.data.category}/`)}>{categoryFor(latest.data.category).name}</a><span>约 {readingMinutes(latest.body)} 分钟</span></div>
          <h3><a href={articleUrl(latest)}>{latest.data.title}</a></h3>
          <p>{latest.data.description}</p>
          <div class="featured-bottom"><time datetime={latest.data.date.toISOString()}>{shortDate(latest.data.date)}</time><a class="text-link" href={articleUrl(latest)}>继续阅读 <Icon name="arrow-right" size={18} /></a></div>
        </div>
        <aside class="featured-aside" aria-label="文章主题">
          <Icon name="plant" size={34} />
          <p>{latest.data.tags[0] || categoryFor(latest.data.category).name}</p>
          <span>从一个问题出发，<br />多想一步，也动手试一试。</span>
        </aside>
      </article> : <p class="empty-inline">第一篇文章正在路上。</p>}
    </section>

    <section class="topics-section" aria-labelledby="topics-title">
      <div class="section-heading"><h2 id="topics-title">沿着兴趣阅读</h2><a class="quiet-link" href={url('categories/')}>所有分类 <Icon name="arrow-right" size={17} /></a></div>
      <CategoryGrid articles={articles} updates={updates} />
    </section>
    {updates.length > 0 && <section class="home-updates" aria-labelledby="updates-title">
      <div class="section-heading"><h2 id="updates-title">近期短札</h2><a class="quiet-link" href={url('trends/')}>趋势与进展 <Icon name="arrow-right" size={17} /></a></div>
      <ul>{updates.slice(0, 3).map((update) => <li><time datetime={update.data.date.toISOString()}>{shortDate(update.data.date)}</time><span>{cadenceLabels[update.data.cadence]}</span><a href={updateUrl(update)}>{update.data.title}<Icon name="arrow-up-right" size={17} /></a></li>)}</ul>
    </section>}
  </div>
</Base>
