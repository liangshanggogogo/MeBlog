---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ModuleArt from '../../components/ModuleArt.astro';
import ArticleList from '../../components/ArticleList.astro';
import { categories, getArticles, url } from '../../lib/blog';
export function getStaticPaths() { return categories.map((category) => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
const articles = await getArticles();
const filtered = articles.filter((article) => article.data.category === category.id);
---
<Base title={category.name} description={category.description} active="categories">
  <div class="shell archive-page">
    <header class="page-heading category-heading"><ModuleArt category={category.id} size={96} /><h1>{category.name}</h1><p>{category.description}</p></header>
    <nav class="category-tabs" aria-label="按模块阅读">
      <a href={url('articles/')}>全部文章 <span>{articles.length}</span></a>
      {categories.map((item) => <a class:list={{ selected: item.id === category.id }} href={url(`categories/${item.id}/`)} aria-current={item.id === category.id ? 'page' : undefined}>{item.name}<span>{articles.filter((a) => a.data.category === item.id).length}</span></a>)}
    </nav>
    {filtered.length ? <ArticleList articles={filtered} /> : <div class="empty-state"><h2>还没有写到这里。</h2><p>这个主题的第一篇文章，留给下一次探索。</p><a class="text-link" href={url('articles/')}>先读其他文章 <Icon name="arrow-right" size={18} /></a></div>}
  </div>
</Base>
